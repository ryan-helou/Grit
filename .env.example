# ── Grit environment ────────────────────────────────────────────────────────
# With NONE of these set, the app runs in DEMO MODE (seeded mock data, no login).
# Fill them in to switch to real Google Health API data. See README "Phase 0".

# Neon Postgres connection string (https://neon.tech → project → connection string)
DATABASE_URL=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on the OAuth client.
# Local: http://localhost:3000/api/auth/callback
# Prod:  https://YOUR-APP.vercel.app/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Comma-separated allowlist of Google emails permitted to sign in (keeps the
# OAuth app in "testing" mode → no Google security assessment needed).
ALLOWED_EMAILS=you@gmail.com

# Secrets — generate with: openssl rand -hex 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Protects the Vercel Cron sync endpoint. openssl rand -hex 32
CRON_SECRET=
